# Machine-local storage (a symlink to the data disk).
/runtime
/external
/local_tests/*
!/local_tests/unit/
!/local_tests/integration/
/local_tests/integration/*
!/local_tests/integration/test_evo_agent_runtime.py
!/local_tests/README.md
!/local_tests/goldens/

# Local orchestration state and caches.
/.agents
/.codex
/.dtach
/.pytest_cache
/.ruff_cache
/.local-runtime
**/__pycache__/
*.py[cod]
*.log

# IDE and OS metadata.
.DS_Store
.idea/
.vscode/
# Isolated local feature checkouts.
/.worktrees/

# Upstream credential and cache exclusions.
# Private local state and credentials.
.git/
.claude/
.codex/
.agents/
secrets/
.env
.env.*
!.env.example
!.env.sample
.netrc
.npmrc
.pypirc
*.key
*.pem

# Local caches and editor state.
__pycache__/
*.py[cod]
*.log
.DS_Store
.idea/
.vscode/
